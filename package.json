{
  "name": "paintingify-ai-backend",
  "private": true,
  "version": "0.0.0",
  "description": "Shopify CLI commands for the existing Python FastAPI backend",
  "scripts": {
    "shopify": "shopify",
    "dev": "shopify app dev",
    "config:validate": "shopify app config validate --json",
    "deploy": "shopify app deploy",
    "dev:python": "python scripts/shopify_dev.py",
    "admin:dev": "npm --prefix frontend run dev",
    "admin:build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@shopify/ui-extensions": "2026.7.0",
    "@shopify/web-pixels-extension": "2.18.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
